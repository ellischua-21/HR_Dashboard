{
  "name": "hr-dashboard-local",
  "version": "1.0.0",
  "private": true,
  "description": "Local Node.js API for the HR Management System dashboard",
  "scripts": {
    "start": "node server/server.js",
    "setup": "node scripts/Setup.js",
    "create-user": "node scripts/create-user.js",
    "sample-data": "node scripts/SampleData.js",
    "test": "node --test tests/Test.js tests/IncidentTracking.test.js",
    "format": "prettier --write \"public/**/*.{html,css,js}\" \"server/**/*.js\" \"shared/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
