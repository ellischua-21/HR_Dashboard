DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hr_dashboard
API_PORT=3001
SESSION_SECRET=
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Attendance: Hik-Connect for Teams / HikCentral Connect OpenAPI.
# Use the regional API host supplied for your account (HTTPS origin, no /api path).
HIKCONNECT_API_BASE_URL=
HIKCONNECT_APP_KEY=
HIKCONNECT_SECRET_KEY=

# Optional second account. Leave all three empty when unused.
# Use this account's regional host (it may be the same as the first account).
HIKCONNECT_2_API_BASE_URL=
HIKCONNECT_2_APP_KEY=
HIKCONNECT_2_SECRET_KEY=
# Further accounts use HIKCONNECT_3_..., HIKCONNECT_4_..., and so on.
