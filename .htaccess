<FilesMatch "^(?:\.env(?:\..*)?|server\.js|package(?:-lock)?\.json|README\.md)$">
  Require all denied
</FilesMatch>

Options -Indexes

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /HR_Dashboard/
  RewriteRule ^$ public/ [R=302,L]
  RewriteRule ^(?:node_modules|server|scripts|tests)(?:/|$) - [F,L,NC]
  RewriteRule ^shared/(?!(?:FormTemplates|FormStatus|FormValidation|DateUtils)\.js$).* - [F,L,NC]
</IfModule>
